{
  "manifest_version": 3,
  "name": "LingoBlend",
  "version": "0.9.3",
  "description": "Feel bilingual from day one of your language learning journey. Blend the vocabulary you’re learning into your everyday web browsing.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://lingoblend-processing.onrender.com/*"
  ],
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon48.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["vocab-header-tokens.js", "aho-corasick.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.duolingo.com/practice-hub/words*"],
      "js": ["duolingo-downloader.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}