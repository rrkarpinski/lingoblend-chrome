{
  "manifest_version": 3,
  "name": "LingoBlend",
  "version": "0.9.1",
  "description": "Substitutes native-language words with target-language words as you browse.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://lingoblend-processing.onrender.com/*"
  ],
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon48.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["vocab-header-tokens.js", "aho-corasick.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.duolingo.com/practice-hub/words*"],
      "js": ["duolingo-downloader.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["dashboard/dashboard.html", "localization/*.json"],
      "matches": ["<all_urls>"]
    }
  ]
}